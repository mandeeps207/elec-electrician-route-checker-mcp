          "starting_point": {
            "type": "string",
            "enum": [
              "complete_beginner",
              "level_2_completed",
              "level_3_completed",
              "already_working_electrical",
              "construction_or_other_trade",
              "unsure"
            ]
          },
          "existing_qualifications": {
            "default": [],
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "none",
                "level_2_technical",
                "level_3_technical",
                "18th_edition",
                "level_3_nvq",
                "am2",
                "other_or_overseas",
                "unsure"
              ]
            }
          },
          "electrical_work_experience": {
            "default": "unsure",
            "type": "string",
            "enum": [
              "none",
              "some",
              "currently_working",
              "significant_experience",
              "unsure"
            ]
          },
          "currently_working_in_electrical": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "study_preference": {
            "default": "unsure",
